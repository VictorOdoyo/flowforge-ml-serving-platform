FLOWFORGE_ENVIRONMENT=local
FLOWFORGE_DEBUG=true
FLOWFORGE_LOG_LEVEL=INFO
FLOWFORGE_DATABASE_URL=postgresql+asyncpg://flowforge:flowforge@localhost:5432/flowforge
FLOWFORGE_REDIS_URL=redis://localhost:6379/0
FLOWFORGE_CELERY_BROKER_URL=redis://localhost:6379/1
FLOWFORGE_CELERY_RESULT_BACKEND=redis://localhost:6379/2
FLOWFORGE_JWT_SECRET=replace-with-a-long-random-secret
FLOWFORGE_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

